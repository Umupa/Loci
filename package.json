{
  "name": "loci-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stable": "vite --mode stable",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check:web && npm run check:rust",
    "check:web": "vitest run && tsc --noEmit",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test",
    "set-version": "node scripts/bump-version.mjs",
    "tauri": "tauri",
    "tauri:stable": "tauri dev --no-watch --config src-tauri/tauri.stable.conf.json"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "cuelume": "^0.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-material-icon-theme": "^1.2.0",
    "rehype-harden": "^1.1.8",
    "shiki": "^3.23.0",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "26.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.0",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
