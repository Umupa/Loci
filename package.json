{
  "name": "loci-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Loci — one desktop app for every agent CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Umupa/Loci.git"
  },
  "homepage": "https://github.com/Umupa/Loci#readme",
  "bugs": {
    "url": "https://github.com/Umupa/Loci/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stable": "vite --mode stable",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:stability": "vitest run --config scripts/acceptance/stability/vitest.config.ts",
    "test:watch": "vitest",
    "check": "npm run check:web && npm run check:rust",
    "check:web": "vitest run && tsc --noEmit",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test",
    "set-version": "node scripts/bump-version.mjs",
    "tauri": "tauri",
    "tauri:stable": "tauri dev --no-watch --config src-tauri/tauri.stable.conf.json"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "cuelume": "^0.2.4",
    "diff": "^9.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-material-icon-theme": "^1.2.0",
    "rehype-harden": "^1.1.8",
    "shiki": "^3.23.0",
    "streamdown": "^2.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
