{
  "name": "loci-desktop",
  "private": true,
  "version": "0.5.0",
  "description": "Loci — an AI-native learning workspace for engineers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Umupa/Loci.git"
  },
  "homepage": "https://github.com/Umupa/Loci#readme",
  "bugs": {
    "url": "https://github.com/Umupa/Loci/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stable": "vite --mode stable",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval": "node scripts/eval/run.mjs",
    "test:stability": "vitest run --config scripts/acceptance/stability/vitest.config.ts",
    "test:watch": "vitest",
    "gen:cli": "UPDATE_CLI_MANIFEST=1 vitest run src/app/commands/manifest.test.ts",
    "check": "npm run check:web && npm run check:rust",
    "check:web": "vitest run && tsc --noEmit",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test",
    "set-version": "node scripts/bump-version.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "tauri:stable": "tauri dev --no-watch --config src-tauri/tauri.stable.conf.json",
    "install:local": "scripts/install-local.sh",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@milkdown/kit": "7.23.0",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "cuelume": "^0.2.8",
    "diff": "^9.0.0",
    "katex": "^0.19.1",
    "mdast-util-from-markdown": "2.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-material-icon-theme": "^1.2.0",
    "rehype-harden": "^1.1.8",
    "shiki": "^3.23.0",
    "streamdown": "^2.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.0",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
