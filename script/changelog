#!/bin/sh
# Prints one released version's section of CHANGELOG.md without its heading:
# the release notes. Fails when the section is missing or empty.
#   script/changelog 1.0.0-alpha.1
set -eu
cd "$(dirname "$0")/.."

version="${1:?usage: script/changelog <version>}"
notes="$(awk -v heading="## $version — " '
  index($0, heading) == 1 { inside = 1; next }
  inside && /^## / { exit }
  inside { print }
' CHANGELOG.md | sed -e '/./,$!d')"

if [ -z "$(printf '%s' "$notes" | tr -d '[:space:]')" ]; then
  echo "changelog: CHANGELOG.md has no section \"## $version — <date>\" with anything in it." >&2
  echo "changelog: cut the version with script/cut-release $version, which names the Unreleased section." >&2
  exit 1
fi
printf '%s\n' "$notes"
