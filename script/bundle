#!/bin/sh
# Builds Loci (Beta).app into output/ and prints its path. `script/run` and
# `script/release` both use this, so the app they open and the app they ship
# are assembled the same way.
#   --configuration <debug|release>  which build the app carries (default: debug)
#   --version <string>               CFBundleShortVersionString (default: the latest version tag
#                                    behind HEAD, such as 1.1.0)
#   --build <string>                 CFBundleVersion (default: the number of commits up to HEAD)
#   --arch <arch>                    an architecture to build; repeat for a universal app
# Environment:
#   LOCI_RELAY_URL, LOCI_RELAY_KEY   the relay that remote access goes through, and its registration key.
#                                    Without them the app has no remote access. Never commit their values.
set -eu
cd "$(dirname "$0")/.."
. script/toolchain

configuration=debug
version="$(git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || echo v0.0.0)"
version="${version#v}"
build="$(git rev-list --count HEAD 2>/dev/null || echo 0)"
# `swift build` arguments, split when used, so each --arch stays one pair.
arches=""
while [ $# -gt 0 ]; do
  case "$1" in
    --configuration) configuration="$2"; shift ;;
    --version) version="$2"; shift ;;
    --build) build="$2"; shift ;;
    --arch) arches="$arches --arch $2"; shift ;;
    *)
      echo "usage: script/bundle [--configuration debug|release] [--version <string>] [--build <string>] [--arch <arch>]..." >&2
      exit 2
      ;;
  esac
  shift
done

swift build -c "$configuration" $arches --product Loci >/dev/null
swift build -c "$configuration" $arches --product LociTool >/dev/null
bin="$(swift build -c "$configuration" $arches --show-bin-path)"

app="output/Loci (Beta).app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$bin/Loci" "$app/Contents/MacOS/Loci"
# The command Loci's agent runs. Not in MacOS/: on a disk that ignores case, `loci` is `Loci`.
mkdir -p "$app/Contents/Helpers"
cp "$bin/LociTool" "$app/Contents/Helpers/loci"
cp script/resources/Loci.icns "$app/Contents/Resources/Loci.icns"
# What macOS says when it asks for the calendars and reminders, in Chinese; English is in Info.plist.
mkdir -p "$app/Contents/Resources/zh-Hans.lproj"
cp script/resources/zh-Hans.lproj/InfoPlist.strings "$app/Contents/Resources/zh-Hans.lproj/InfoPlist.strings"
for bundle in "$bin"/*.bundle; do
  if [ -d "$bundle" ]; then cp -R "$bundle" "$app/Contents/Resources/"; fi
done
# Frameworks from binary targets (whisper.cpp) go where the executable looks
# for them; SwiftPM itself links them next to the binary.
for framework in "$bin"/*.framework; do
  if [ -d "$framework" ]; then
    mkdir -p "$app/Contents/Frameworks"
    cp -R "$framework" "$app/Contents/Frameworks/"
  fi
done
if [ -d "$app/Contents/Frameworks" ]; then
  install_name_tool -add_rpath @executable_path/../Frameworks "$app/Contents/MacOS/Loci" 2>/dev/null || true
fi
relay=""
if [ -n "${LOCI_RELAY_URL:-}" ] && [ -n "${LOCI_RELAY_KEY:-}" ]; then
  relay="<key>LociRelayURL</key><string>$LOCI_RELAY_URL</string>
  <key>LociRelayKey</key><string>$LOCI_RELAY_KEY</string>"
fi
cat >"$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>Loci</string>
  <key>CFBundleIdentifier</key><string>com.loci.native.dev</string>
  <key>CFBundleName</key><string>Loci (Beta)</string>
  <key>CFBundleDisplayName</key><string>Loci (Beta)</string>
  <key>CFBundleIconFile</key><string>Loci.icns</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$version</string>
  <key>CFBundleVersion</key><string>$build</string>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleLocalizations</key><array><string>en</string><string>zh-Hans</string></array>
  <key>LSMinimumSystemVersion</key><string>26.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSLocalNetworkUsageDescription</key><string>Loci finds your other Macs on this network so you can pair them.</string>
  <key>NSBonjourServices</key><array><string>_loci._tcp</string></array>
  <key>NSCalendarsFullAccessUsageDescription</key><string>Loci reads your calendar for your companion when you connect it. It adds an event only when you approve a card, and you can undo it.</string>
  <key>NSRemindersFullAccessUsageDescription</key><string>Loci reads your reminders for your companion when you connect them. It adds a reminder only when you approve a card, and you can undo it.</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>EPUB Book</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>org.idpf.epub-container</string></array>
    </dict>
  </array>
  $relay
</dict>
</plist>
PLIST
echo "$app"
