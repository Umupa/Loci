#!/bin/sh
# Builds Loci Dev.app into output/ and opens it. Pass --no-open to only build.
set -eu
cd "$(dirname "$0")/.."
. script/toolchain

swift build --product Loci >/dev/null
app="output/Loci Dev.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp "$(swift build --show-bin-path)/Loci" "$app/Contents/MacOS/Loci"
cat >"$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>Loci</string>
  <key>CFBundleIdentifier</key><string>com.loci.native.dev</string>
  <key>CFBundleName</key><string>Loci Dev</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0.0-alpha</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>26.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST
codesign --force --sign - "$app" 2>/dev/null
echo "$app"
[ "${1:-}" = "--no-open" ] || open "$app"
