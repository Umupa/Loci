#!/bin/sh
# Builds Loci Dev.app into output/ and opens it.
#   --no-open        only build
#   --root <folder>  run with LOCI_ROOT=<folder> instead of ~/Loci Dev
set -eu
cd "$(dirname "$0")/.."
. script/toolchain

open_app=yes
root=""
while [ $# -gt 0 ]; do
  case "$1" in
    --no-open) open_app=no ;;
    --root) root="$2"; shift ;;
    *) echo "usage: script/run [--no-open] [--root <folder>]" >&2; exit 2 ;;
  esac
  shift
done

app="$(script/bundle)"
codesign --force --deep --sign - "$app" 2>/dev/null
echo "$app"
[ "$open_app" = yes ] || exit 0
if [ -n "$root" ]; then
  open -n --env "LOCI_ROOT=$root" "$app"
else
  open "$app"
fi
