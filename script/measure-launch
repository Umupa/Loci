#!/bin/sh
# Launches Loci Dev several times against a temporary folder and reports, for each launch, how long the
# process took to show the main conversation (α1-S10's budget is 500 ms) and the worst of them.
#   --runs <n>     how many launches to measure (default 5)
#   --app <path>   the app to measure (default: build the dev app with script/run --no-open)
#
# Every launch goes through `open` with a fresh data folder, so it opens at the main conversation.
set -eu
cd "$(dirname "$0")/.."
. script/toolchain

runs=5
app=""
while [ $# -gt 0 ]; do
  case "$1" in
    --runs) runs="$2"; shift ;;
    --app) app="$2"; shift ;;
    *)
      echo "usage: script/measure-launch [--runs <n>] [--app <path>]" >&2
      exit 2
      ;;
  esac
  shift
done
if ! [ "$runs" -ge 1 ] 2>/dev/null; then
  echo "--runs must be a positive integer" >&2
  exit 2
fi
[ -n "$app" ] || app="$(script/run --no-open)"
app="$(cd "$(dirname "$app")" && pwd)/$(basename "$app")"

binary="$app/Contents/MacOS/Loci"

processes() {
  ps -axo pid=,comm= | LOCI_MEASURE_BINARY="$binary" awk '{
    pid = $1
    sub(/^[[:space:]]*[0-9]+[[:space:]]+/, "")
    if ($0 == ENVIRON["LOCI_MEASURE_BINARY"]) print pid
  }'
}

if [ -n "$(processes)" ]; then
  echo "close the app being measured before starting the launch runs" >&2
  exit 1
fi

root="$(mktemp -d)"
pid=""

# Waits for this launch to quit before starting another one.
stop() {
  if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; fi
  for _ in $(seq 30); do
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then break; fi
    sleep 0.1
  done
}

trap '
  stop
  rm -rf "$root"
' EXIT

measured=""
missing=0
for run in $(seq "$runs"); do
  folder="$root/$run"
  mkdir "$folder"
  since="$(date '+%Y-%m-%d %H:%M:%S')"
  pid=""
  open -n --env "LOCI_ROOT=$folder" "$app"
  for _ in $(seq 40); do
    pid="$(processes)"
    if [ -n "$pid" ]; then break; fi
    sleep 0.1
  done
  case "$pid" in
    *[!0-9]*)
      pid=""
      echo "found multiple instances of the app being measured" >&2
      exit 1
      ;;
  esac
  sleep 3
  stop
  elapsed="$(
    /usr/bin/log show --start "$since" --style compact \
      --predicate "subsystem == \"com.loci.native.dev\" AND category == \"launch\" AND processID == ${pid:-0}" 2>/dev/null |
      sed -n 's/.*main conversation shown \([0-9][0-9]*\) ms after launch.*/\1/p'
  )"
  pid=""
  if [ -n "$elapsed" ]; then
    echo "run $run: $elapsed ms"
    measured="$measured $elapsed"
  else
    echo "run $run: no main conversation was reported"
    missing=1
  fi
done

if [ -n "$measured" ]; then
  echo "worst: $(echo $measured | tr ' ' '\n' | sort -n | tail -1) ms"
else
  echo "no launch reported a main conversation"
  exit 1
fi
exit "$missing"
